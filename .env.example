# secrets/backend.env にコピーして実値を設定する。引用符を付けず KEY=value 形式にする。
# APP_KEY は既存アプリなら既存値を使う。変更すると暗号化済みデータを読めなくなる。
APP_KEY=REPLACE_WITH_EXISTING_OR_NEW_LARAVEL_APP_KEY
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_REACHABLE_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_DATABASE_NAME
DB_USERNAME=REPLACE_DATABASE_USER
DB_PASSWORD=REPLACE_DATABASE_PASSWORD
